<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Крестовина будит экран (у раскладушки клавиатура внутри: при закрытой крышке не нажать). -->
    <bool name="config_wakeOnDpadKeyPress">true</bool>

    <!-- Тема Nine для всего, что остаётся от AOSP: тёмная по умолчанию (UiModeManager.MODE_NIGHT_YES,
         действует на новых установках; на уже настроенном телефоне — Настройки → Экран → Тёмная тема). -->
    <integer name="config_defaultNightMode">2</integer>

    <!-- Моноширинный шрифт, как у приложений Nine (DroidSansMono, с кириллицей). -->
    <string name="config_headlineFontFamily" translatable="false">monospace</string>
    <string name="config_headlineFontFamilyMedium" translatable="false">monospace</string>
    <string name="config_bodyFontFamily" translatable="false">monospace</string>
    <string name="config_bodyFontFamilyMedium" translatable="false">monospace</string>

    <!-- Звонки и SMS по умолчанию — P9 и M9 (apps/). -->
    <string name="config_defaultDialer" translatable="false">io.github.ninetailsflip.p9</string>
    <string name="config_defaultSms" translatable="false">io.github.ninetailsflip.m9</string>

    <!-- Без экранных кнопок Назад/Домой/Недавние: у раскладушки они есть на клавиатуре. -->
    <bool name="config_showNavigationBar">false</bool>

    <!-- «Недавние» — экран L9 (apps/: стоковый Launcher3 Quickstep в образ не входит). Пакет из
         этого значения получает права recents (START_TASKS_FROM_RECENTS, REMOVE_TASKS), а
         SystemUI ищет в нём сервис Quickstep: пустое значение роняет SystemUI. Открывает экран
         PhoneWindowManager по ro.config.thor2_recents (thor2.mk, patches/frameworks_base 0005). -->
    <string name="config_recentsComponentName" translatable="false">io.github.ninetailsflip.l9/life.furrer.l9.RecentsActivity</string>

    <!-- The Nine apps' notification listeners are on from the first boot: L9's home screen, Lock,
         Settings' shade and status bar, ThorSubScreen's outer screen. Do not disturb: Settings. -->
    <string name="config_defaultListenerAccessPackages" translatable="false">io.github.ninetailsflip.l9:io.github.ninetailsflip.lock:io.github.ninetailsflip.settings:org.thor2.subscreen</string>
    <string name="config_defaultDndAccessPackages" translatable="false">io.github.ninetailsflip.settings</string>

    <!-- G9 is the gallery (the SYSTEM_GALLERY role); Glimpse is left out of the image. -->
    <string name="config_systemGallery" translatable="false">io.github.ninetailsflip.g9</string>

    <!-- Диалоги системы с прямыми углами, как экраны Nine, а не скруглённые на 28dp. -->
    <dimen name="config_dialogCornerRadius">0dp</dimen>
    <dimen name="config_bottomDialogCornerRadius">0dp</dimen>
</resources>
