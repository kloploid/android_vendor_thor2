// NineTailsFlip's apps, preinstalled. The APKs come from fetch.py (latest GitHub releases) and
// keep their own release signature (presigned), so the copies in the image update from GitHub.

// TG9: Telegram.
android_app_import {
    name: "NineTG9",
    apk: "prebuilt/tg9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// G9: gallery.
android_app_import {
    name: "NineG9",
    apk: "prebuilt/g9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

