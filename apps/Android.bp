// NineTailsFlip's apps, preinstalled. The APKs come from fetch.py (latest GitHub releases) and
// keep their own release signature (presigned), so the copies in the image update from GitHub.

// TG9: Telegram.
android_app_import {
    name: "NineTG9",
    apk: "prebuilt/tg9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// G9: gallery.
android_app_import {
    name: "NineG9",
    apk: "prebuilt/g9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// L9: launcher.
android_app_import {
    name: "NineL9",
    apk: "prebuilt/l9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// C9: calendars and contacts.
android_app_import {
    name: "NineC9",
    apk: "prebuilt/c9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// P9: phone.
android_app_import {
    name: "NineP9",
    apk: "prebuilt/p9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// M9: messages.
android_app_import {
    name: "NineM9",
    apk: "prebuilt/m9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// K9: the keyboard (Traditional T9 on nine-core). Setup makes it the keyboard in use.
android_app_import {
    name: "NineK9",
    apk: "prebuilt/k9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// Setup: the first-time setup in the Nine suite's look, in place of LineageSetupWizard. Unlike
// the apps above it's re-signed here with the platform key (it sets the system's language, time,
// Wi-Fi and lock), so it updates only with the image.
android_app_import {
    name: "NineSetup",
    apk: "prebuilt/setup9.apk",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    overrides: ["LineageSetupWizard"],
    required: ["privapp-permissions-nine-setup.xml"],
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-nine-setup.xml",
    src: "privapp-permissions-nine-setup.xml",
    sub_dir: "permissions",
    product_specific: true,
}
