// NineTailsFlip's apps, preinstalled. The APKs come from fetch.py (latest GitHub releases) and
// keep their own release signature (presigned), so the copies in the image update from GitHub.

// TG9: Telegram.
android_app_import {
    name: "NineTG9",
    apk: "prebuilt/tg9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// G9: gallery.
android_app_import {
    name: "NineG9",
    apk: "prebuilt/g9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    // The only gallery: Lineage's Glimpse is left out of the image.
    overrides: ["Glimpse"],
    dex_preopt: {
        enabled: false,
    },
}

// L9: launcher.
android_app_import {
    name: "NineL9",
    apk: "prebuilt/l9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    // L9 is the only launcher: home screen and Recents (config_recentsComponentName,
    // ro.config.thor2_recents). Quickstep's Taskbar drew Back/Home/Recents buttons on screen.
    overrides: ["Launcher3QuickStep"],
    required: ["nine-l9-hiddenapi.xml"],
    dex_preopt: {
        enabled: false,
    },
}

// L9's Recents opens and closes other apps' tasks through IActivityTaskManager, which has no SDK
// API; this lets the system app L9 make those calls.
prebuilt_etc {
    name: "nine-l9-hiddenapi.xml",
    src: "nine-l9-hiddenapi.xml",
    sub_dir: "sysconfig",
    product_specific: true,
}

// C9: calendars and contacts.
android_app_import {
    name: "NineC9",
    apk: "prebuilt/c9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    // The only contacts and calendar: the stock Contacts and Lineage's Etar are left out.
    overrides: ["Contacts", "Etar"],
    dex_preopt: {
        enabled: false,
    },
}

// P9: phone.
android_app_import {
    name: "NineP9",
    apk: "prebuilt/p9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    // The only phone app: the stock Dialer is left out (P9 is the default dialer).
    overrides: ["Dialer"],
    dex_preopt: {
        enabled: false,
    },
}

// M9: messages.
android_app_import {
    name: "NineM9",
    apk: "prebuilt/m9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    // The only messages app: the stock Messaging is left out (M9 is the default SMS app).
    overrides: ["messaging"],
    dex_preopt: {
        enabled: false,
    },
}

// K9: the keyboard (Traditional T9 on nine-core). Setup makes it the keyboard in use.
android_app_import {
    name: "NineK9",
    apk: "prebuilt/k9.apk",
    presigned: true,
    // Signed with v2/v3 by their release builds: Soong must not repack them.
    preprocessed: true,
    product_specific: true,
    // The only keyboard: the stock LatinIME (a touch keyboard) is left out.
    overrides: ["LatinIME"],
    dex_preopt: {
        enabled: false,
    },
}

// Setup: the first-time setup in the Nine suite's look, in place of LineageSetupWizard. Unlike
// the apps above it's re-signed here with the platform key (it sets the system's language, time,
// Wi-Fi and lock), so it updates only with the image.
android_app_import {
    name: "NineSetup",
    apk: "prebuilt/setup9.apk",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    overrides: ["LineageSetupWizard"],
    required: ["privapp-permissions-nine-setup.xml"],
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-nine-setup.xml",
    src: "privapp-permissions-nine-setup.xml",
    sub_dir: "permissions",
    product_specific: true,
}

// Settings in the Nine look (settings9): the phone's settings, platform-signed and privileged like
// NineSetup, so it can change system settings. The stock Settings app stays for the system's own
// dialogs (Bluetooth pairing, FallbackHome, confirming the PIN) and the pages not ported yet; its
// launcher icon is hidden by Settings and its android.settings.* filters are outranked.
android_app_import {
    name: "NineSettings",
    apk: "prebuilt/settings9.apk",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    required: ["privapp-permissions-nine-settings.xml"],
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-nine-settings.xml",
    src: "privapp-permissions-nine-settings.xml",
    sub_dir: "permissions",
    product_specific: true,
}

// The lock screen in the Nine look (lock9): shown over the keyguard, which stays the security
// boundary. Platform-signed and privileged (it checks the PIN through LockSettingsService and asks
// SystemUI to finish the keyguard: frameworks_base 0006), persistent and direct-boot aware.
android_app_import {
    name: "NineLock",
    apk: "prebuilt/lock9.apk",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    required: ["privapp-permissions-nine-lock.xml"],
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-nine-lock.xml",
    src: "privapp-permissions-nine-lock.xml",
    sub_dir: "permissions",
    product_specific: true,
}

// What the Nine apps may do from the first boot, without asking: their runtime permissions
// (default-permissions: granted at the first boot and again after an update of the image, and the
// user can still take them back), and TG9 kept out of battery optimization so its background
// connection - the only way messages arrive without Google's push - lives through Doze.
prebuilt_etc {
    name: "default-permissions-nine.xml",
    src: "default-permissions-nine.xml",
    sub_dir: "default-permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "sysconfig-nine.xml",
    src: "sysconfig-nine.xml",
    sub_dir: "sysconfig",
    product_specific: true,
}
