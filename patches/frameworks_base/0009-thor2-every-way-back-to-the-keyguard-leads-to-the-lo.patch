From: kloploid <10303425+kloploid@users.noreply.github.com>
Date: Thu, 26 Nov 2026 16:13:38 +0200
Subject: [PATCH 1/2] thor2: every way back to the keyguard leads to the lock
 screen app

With ro.config.thor2_lockscreen set, the lock screen app is the lock
screen, and the stock keyguard no longer shows from under it:

- KeyguardViewMediator: when the keyguard is uncovered with the screen on
  (an app shown over it finished), the lock screen app is started again;
  when an app over the keyguard asks for it to go (requestDismissKeyguard,
  say the secure camera opening the gallery), the lock screen app takes the
  PIN instead of the bouncer, and its unlock reaches the dismiss callback.
  When the lock screen app is itself in front, it asked for the stock UI
  (a pattern or password), which comes up as before.
- PhoneWindowManager: Home over an app on the keyguard starts the lock
  screen app, which goes home once unlocked, instead of uncovering the
  stock keyguard.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I9bc55bf9d26f626c5d0e99c2458fb5d7df1d7cb2
---
 .../keyguard/KeyguardViewMediator.java        | 53 +++++++++++++++++++
 .../server/policy/PhoneWindowManager.java     | 27 ++++++++++
 2 files changed, 80 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
index 9cee296b0..3e30b2927 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/KeyguardViewMediator.java
@@ -2417,6 +2417,11 @@ public class KeyguardViewMediator implements CoreStartable,
                             && mDeviceInteractive);
                 }
                 adjustStatusBarLocked();
+                if (!isOccluded) {
+                    // thor2: whatever showed over the keyguard went (Home on the camera, an app
+                    // that finished): the lock screen app comes back rather than the stock one.
+                    mHandler.post(this::thor2ShowLockScreenIfUncovered);
+                }
             }
 
             if (DEBUG) {
@@ -2641,6 +2646,12 @@ public class KeyguardViewMediator implements CoreStartable,
                 mDismissCallbackRegistry.addCallback(callback);
             }
             mCustomMessage = message;
+            // thor2: an app over the keyguard asked for it to go (the camera's gallery, say): the
+            // PIN is typed on the lock screen app, whose unlock reaches the callback above. When
+            // that app itself asks (a pattern or password), the stock bouncer it wants comes up.
+            if (thor2ShowLockScreen(true /* dismiss */)) {
+                return;
+            }
             mKeyguardViewControllerLazy.get().dismissAndCollapse();
             return;
         }
@@ -2809,6 +2820,48 @@ public class KeyguardViewMediator implements CoreStartable,
     }
 
     private static final String THOR2_UNLOCK_ACTION = "org.thor2.keyguard.action.UNLOCK";
+    private static final String THOR2_SHOW_ACTION = "org.thor2.keyguard.action.SHOW";
+    private static final String THOR2_EXTRA_DISMISS = "org.thor2.keyguard.extra.DISMISS";
+
+    /** See handleSetOccluded: the keyguard is up, uncovered, with the screen on. */
+    private void thor2ShowLockScreenIfUncovered() {
+        if (mShowing && !mOccluded && mDeviceInteractive && !mHiding
+                && !mKeyguardStateController.isKeyguardGoingAway()) {
+            thor2ShowLockScreen(false /* dismiss */);
+        }
+    }
+
+    /**
+     * Puts the thor2 lock screen app (ro.config.thor2_lockscreen, a package) in front, in place
+     * of the stock keyguard or bouncer. false: there is none, it's already in front (and so
+     * asked for the stock UI itself), or it couldn't start - the stock UI stays.
+     */
+    private boolean thor2ShowLockScreen(boolean dismiss) {
+        String lockScreen = SystemProperties.get("ro.config.thor2_lockscreen", "");
+        if (lockScreen.isEmpty()) return false;
+        try {
+            ActivityTaskManager.RootTaskInfo top =
+                    ActivityTaskManager.getService().getFocusedRootTaskInfo();
+            if (top != null && top.topActivity != null
+                    && lockScreen.equals(top.topActivity.getPackageName())) {
+                return false;
+            }
+        } catch (RemoteException e) {
+            // Can't tell what's in front: show it anyway.
+        }
+        Intent intent = new Intent(THOR2_SHOW_ACTION).setPackage(lockScreen)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_NO_ANIMATION)
+                .putExtra(THOR2_EXTRA_DISMISS, dismiss);
+        try {
+            mContext.startActivityAsUser(intent,
+                    UserHandle.of(mSelectedUserInteractor.getSelectedUserId()));
+            Log.d(TAG, "thor2: the lock screen app instead of the stock one, dismiss=" + dismiss);
+            return true;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "thor2: couldn't start the lock screen app", e);
+            return false;
+        }
+    }
 
     /** See setupLocked: the thor2 lock screen app unlocked the phone. */
     private final BroadcastReceiver mThor2UnlockReceiver = new BroadcastReceiver() {
diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index 3b83763be..476b4fcdc 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -4802,6 +4802,12 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                 return;
             }
 
+            if (isKeyguardOccluded() && thor2ShowLockScreenThenHome()) {
+                // thor2: Home over another app on the keyguard (the camera, a call) brings the
+                // lock screen app back, not the stock keyguard; home follows the unlock.
+                return;
+            }
+
             if (!isKeyguardOccluded() && mKeyguardDelegate.isInputRestricted()) {
                 // when in keyguard restricted mode, must first verify unlock
                 // before launching home
@@ -5079,6 +5085,27 @@ public class PhoneWindowManager implements WindowManagerPolicy {
     /** The package owning the focused window on the default display (onDefaultDisplayFocusChangedLw). */
     private volatile String mThor2FocusedPackage;
 
+    /** Starts the thor2 lock screen app, which goes home once unlocked. false: there is none. */
+    private boolean thor2ShowLockScreenThenHome() {
+        String lockScreen = SystemProperties.get("ro.config.thor2_lockscreen", "");
+        if (lockScreen.isEmpty()) {
+            return false;
+        }
+        Intent intent = new Intent("org.thor2.keyguard.action.SHOW").setPackage(lockScreen)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_NO_ANIMATION)
+                .putExtra("org.thor2.keyguard.extra.THEN_HOME", true);
+        final long token = Binder.clearCallingIdentity();
+        try {
+            mContext.startActivityAsUser(intent, UserHandle.CURRENT);
+            return true;
+        } catch (ActivityNotFoundException | SecurityException e) {
+            Slog.w(TAG, "thor2: no lock screen app to show", e);
+            return false;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
     /** The thor2 lock screen app (ro.config.thor2_lockscreen, a package) has the focus. */
     private boolean thor2LockScreenFocused() {
         String lockScreen = SystemProperties.get("ro.config.thor2_lockscreen", "");
