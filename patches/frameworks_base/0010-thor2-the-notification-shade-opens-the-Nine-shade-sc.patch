+        if (thor2Shade("settings", false /* toggle */)) {
+            return;
+        }
+
         if (mBar != null) {
             try {
                 mBar.animateExpandSettingsPanel(subPanel);
@@ -1132,6 +1147,39 @@ public class StatusBarManagerService extends IStatusBarService.Stub implements D
         }
     }
 
+    /**
+     * thor2: the notification shade and quick settings are an app's screen
+     * (ro.config.thor2_shade, an activity), not SystemUI's panel, which a phone without a
+     * touchscreen can't use. [panel] is what to open on ("notifications", "settings");
+     * [toggle] closes the screen when it's already open. While the phone is locked nothing
+     * opens: the lock screen app shows the notifications. false: no such screen.
+     */
+    private boolean thor2Shade(String panel, boolean toggle) {
+        ComponentName shade = ComponentName.unflattenFromString(
+                SystemProperties.get("ro.config.thor2_shade", ""));
+        if (shade == null) {
+            return false;
+        }
+        final long token = Binder.clearCallingIdentity();
+        try {
+            KeyguardManager keyguard = mContext.getSystemService(KeyguardManager.class);
+            if (keyguard != null && keyguard.isKeyguardLocked()) {
+                return true;
+            }
+            Intent intent = new Intent(Intent.ACTION_MAIN).setComponent(shade)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                    .putExtra("org.thor2.shade.extra.PANEL", panel)
+                    .putExtra("org.thor2.shade.extra.TOGGLE", toggle);
+            mContext.startActivityAsUser(intent, UserHandle.CURRENT);
+            return true;
+        } catch (ActivityNotFoundException | SecurityException e) {
+            Slog.w(TAG, "thor2: no shade screen " + shade, e);
+            return false;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
     public void addTile(ComponentName component) {
         addQsTileToFrontOrEnd(component, false);
     }
