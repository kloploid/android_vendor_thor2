From 4334778ee3a78b99658f8ebd8eccf772d57594b2 Mon Sep 17 00:00:00 2001
From: kloploid <10303425+kloploid@users.noreply.github.com>
Date: Tue, 6 Oct 2026 20:45:51 +0300
Subject: [PATCH 4/4] PhoneFallbackEventHandler: pass camera and call keys
 through on thor2

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I76b5f99f284e253efa5bae1e456a41412dcf64a4
---
 .../internal/policy/PhoneFallbackEventHandler.java | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/core/java/com/android/internal/policy/PhoneFallbackEventHandler.java b/core/java/com/android/internal/policy/PhoneFallbackEventHandler.java
index 8ce39d703..020488c9a 100644
--- a/core/java/com/android/internal/policy/PhoneFallbackEventHandler.java
+++ b/core/java/com/android/internal/policy/PhoneFallbackEventHandler.java
@@ -25,6 +25,7 @@ import android.content.Intent;
 import android.content.res.Configuration;
 import android.media.AudioManager;
 import android.media.session.MediaSessionManager;
+import android.os.SystemProperties;
 import android.os.UserHandle;
 import android.provider.Settings;
 import android.telephony.TelephonyManager;
@@ -65,10 +66,23 @@ public class PhoneFallbackEventHandler implements FallbackEventHandler {
         getAudioManager().preDispatchKeyEvent(event, AudioManager.USE_DEFAULT_STREAM_TYPE);
     }
 
+    /**
+     * thor2 (кнопочная раскладушка): Камеру и Зелёную, не обработанные приложением, не трогаем —
+     * тогда они уходят в PhoneWindowManager.interceptUnhandledKey и дальше в настраиваемые
+     * действия кнопок (ThorSubScreen). Иначе Камера молча съедается, а Зелёная всегда открывает
+     * набор номера.
+     */
+    private static final boolean THOR2_KEYPAD =
+            SystemProperties.getBoolean("ro.config.thor2_keypad_focus", false);
+
     public boolean dispatchKeyEvent(KeyEvent event) {
 
         final int action = event.getAction();
         final int keyCode = event.getKeyCode();
+        if (THOR2_KEYPAD
+                && (keyCode == KeyEvent.KEYCODE_CAMERA || keyCode == KeyEvent.KEYCODE_CALL)) {
+            return false;
+        }
 
         if (action == KeyEvent.ACTION_DOWN) {
             return onKeyDown(keyCode, event);
