diff --git a/services/java/com/android/server/SystemServer.java b/services/java/com/android/server/SystemServer.java
index a184d6a7e..718003e91 100644
--- a/services/java/com/android/server/SystemServer.java
+++ b/services/java/com/android/server/SystemServer.java
@@ -46,6 +46,7 @@ import android.content.ComponentName;
 import android.content.ContentResolver;
 import android.content.Context;
 import android.content.Intent;
+import android.content.ServiceConnection;
 import android.content.pm.PackageItemInfo;
 import android.content.pm.PackageManager;
 import android.content.pm.PackageManagerInternal;
@@ -84,6 +85,7 @@ import android.os.SystemProperties;
 import android.os.Trace;
 import android.os.UserHandle;
 import android.os.UserManager;
+import android.os.Handler;
 import android.os.storage.IStorageManager;
 import android.provider.DeviceConfig;
 import android.provider.Settings;
@@ -3777,6 +3779,61 @@ public final class SystemServer implements Dumpable {
         //Slog.d(TAG, "Starting service: " + intent);
         context.startServiceAsUser(intent, UserHandle.SYSTEM);
         windowManager.onSystemUiStarted();
+        startThor2StatusBar(context);
+    }
+
+    /**
+     * thor2: the status bar is an app's service (ro.config.thor2_statusbar), kept running like
+     * SystemUI: bound from boot (it's direct-boot aware), important, and bound again when its
+     * app is updated or can't be bound yet.
+     */
+    private static void startThor2StatusBar(Context context) {
+        final ComponentName bar = ComponentName.unflattenFromString(
+                SystemProperties.get("ro.config.thor2_statusbar", ""));
+        if (bar == null) {
+            return;
+        }
+        final Handler handler = new Handler(Looper.getMainLooper());
+        final ServiceConnection connection = new ServiceConnection() {
+            @Override
+            public void onServiceConnected(ComponentName name, IBinder service) {
+                Slog.i(TAG, "thor2: status bar " + name + " running");
+            }
+
+            @Override
+            public void onServiceDisconnected(ComponentName name) {
+                // The binding restarts it by itself.
+            }
+
+            @Override
+            public void onBindingDied(ComponentName name) {
+                Slog.w(TAG, "thor2: status bar " + name + " gone; binding it again");
+                context.unbindService(this);
+                handler.postDelayed(() -> bindThor2StatusBar(context, bar, this, handler), 1000);
+            }
+        };
+        bindThor2StatusBar(context, bar, connection, handler);
+    }
+
+    private static void bindThor2StatusBar(Context context, ComponentName bar,
+            ServiceConnection connection, Handler handler) {
+        final Intent intent = new Intent().setComponent(bar);
+        boolean bound = false;
+        try {
+            bound = context.bindServiceAsUser(intent, connection,
+                    Context.BIND_AUTO_CREATE | Context.BIND_IMPORTANT
+                            | Context.BIND_FOREGROUND_SERVICE, UserHandle.SYSTEM);
+        } catch (SecurityException e) {
+            Slog.w(TAG, "thor2: can't bind the status bar " + bar, e);
+        }
+        if (!bound) {
+            try {
+                context.unbindService(connection);
+            } catch (IllegalArgumentException e) {
+                // Not registered: nothing to release.
+            }
+            handler.postDelayed(() -> bindThor2StatusBar(context, bar, connection, handler), 5000);
+        }
     }
 
     /**
